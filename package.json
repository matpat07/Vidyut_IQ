{
  "name": "vidyutiq",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix Frontend ci --no-audit --no-fund",
    "dev": "npm --prefix Frontend run dev --",
    "build": "npm --prefix Frontend run build",
    "preview": "npm --prefix Frontend run preview --",
    "test": "npm --prefix Frontend test",
    "typecheck": "npm --prefix Frontend exec tsc -- --noEmit",
    "verify:landing": "npm --prefix Frontend run verify:landing",
    "verify:radar": "npm --prefix Frontend run verify:radar",
    "verify:submission": "npm --prefix Frontend run verify:submission",
    "dev:legacy": "vite",
    "build:legacy": "tsc && vite build",
    "preview:legacy": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
